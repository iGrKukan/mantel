<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Advarslen "Ryd hylden?" før hele hylden flyttes til Papirkurven. -->
	<key>alert.clearAll.message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d element flyttes til Papirkurven. Det kan kun fortrydes derfra.</string>
			<key>other</key>
			<string>%d elementer flyttes til Papirkurven. Det kan kun fortrydes derfra.</string>
		</dict>
	</dict>

	<!-- Etiketten for automatisk oprydning "Slet filer ældre end N dage". -->
	<key>settings.shelf.pruneLabel.on</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Filer ældre end %#@days@ flyttes til Papirkurven. Tjekkes ved opstart og hver time.</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d dag</string>
			<key>other</key>
			<string>%d dage</string>
		</dict>
	</dict>

	<!-- Beskeden "Uploadet til Google Drive ("mappe"): N fil(er)". -->
	<key>toast.uploaded.message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Uploadet til Google Drive (“%@”): %#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d fil</string>
			<key>other</key>
			<string>%d filer</string>
		</dict>
	</dict>
</dict>
</plist>
