<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Clear the shelf?" NSAlert warning before moving the whole shelf to the Trash. -->
	<key>alert.clearAll.message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d Element wird in den Papierkorb verschoben. Das lässt sich nur aus dem Papierkorb rückgängig machen.</string>
			<key>other</key>
			<string>%d Elemente werden in den Papierkorb verschoben. Das lässt sich nur aus dem Papierkorb rückgängig machen.</string>
		</dict>
	</dict>

	<!-- "Delete files older than N days" auto-cleanup label — the Russian source text uses
	     the invariant abbreviation "дн." and needs no stringsdict entry, but English "day/days"
	     does. -->
	<key>settings.shelf.pruneLabel.on</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Dateien, die älter als %#@days@ sind, werden in den Papierkorb verschoben. Prüfung beim Start und einmal pro Stunde.</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d Tag</string>
			<key>other</key>
			<string>%d Tage</string>
		</dict>
	</dict>

	<!-- "Uploaded to Google Drive ("folder"): N file(s)" toast. -->
	<key>toast.uploaded.message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Zu Google Drive hochgeladen („%@“): %#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d Datei</string>
			<key>other</key>
			<string>%d Dateien</string>
		</dict>
	</dict>
</dict>
</plist>
