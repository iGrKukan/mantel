<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Clear the shelf?" NSAlert warning before moving the whole shelf to the Trash. -->
	<key>alert.clearAll.message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d élément sera déplacé vers la Corbeille. Vous ne pourrez annuler cette action que depuis la Corbeille.</string>
			<key>other</key>
			<string>%d éléments seront déplacés vers la Corbeille. Vous ne pourrez annuler cette action que depuis la Corbeille.</string>
		</dict>
	</dict>

	<!-- "Delete files older than N days" auto-cleanup label — the Russian source text uses
	     the invariant abbreviation "дн." and needs no stringsdict entry, but English "day/days"
	     does. -->
	<key>settings.shelf.pruneLabel.on</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Les fichiers de plus de %#@days@ sont déplacés vers la Corbeille. Vérification au démarrage et une fois par heure.</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d jour</string>
			<key>other</key>
			<string>%d jours</string>
		</dict>
	</dict>

	<!-- "Uploaded to Google Drive ("folder"): N file(s)" toast. -->
	<key>toast.uploaded.message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Envoyé vers Google Drive (« %@ ») : %#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d fichier</string>
			<key>other</key>
			<string>%d fichiers</string>
		</dict>
	</dict>
</dict>
</plist>
