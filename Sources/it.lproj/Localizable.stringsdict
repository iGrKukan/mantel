<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Clear the shelf?" NSAlert warning before moving the whole shelf to the Trash. -->
	<key>alert.clearAll.message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@items@</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d elemento verrà spostato nel Cestino. Puoi annullare l'operazione solo dal Cestino.</string>
			<key>other</key>
			<string>%d elementi verranno spostati nel Cestino. Puoi annullare l'operazione solo dal Cestino.</string>
		</dict>
	</dict>

	<!-- "Delete files older than N days" auto-cleanup label — the Russian source text uses
	     the invariant abbreviation "дн." and needs no stringsdict entry, but English "day/days"
	     does. -->
	<key>settings.shelf.pruneLabel.on</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>I file più vecchi di %#@days@ vengono spostati nel Cestino. Controllo all'avvio e una volta all'ora.</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d giorno</string>
			<key>other</key>
			<string>%d giorni</string>
		</dict>
	</dict>

	<!-- "Uploaded to Google Drive ("folder"): N file(s)" toast. -->
	<key>toast.uploaded.message</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Caricato su Google Drive (“%@”): %#@files@</string>
		<key>files</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d file</string>
			<key>other</key>
			<string>%d file</string>
		</dict>
	</dict>
</dict>
</plist>
